<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.8.0</Version>
    <Description>Recommended Google client library to access the Google Cloud Functions API (v2), which manages lightweight user-provided functions executed in response to events.</Description>
    <PackageTags>functions;Google;Cloud</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Cloud.Iam.V1" />
    <PackageReference Include="Google.Cloud.Location" />
    <PackageReference Include="Google.LongRunning" />
  </ItemGroup>
  <Import Project="../../GapicProductionProperties.xml" />
</Project>